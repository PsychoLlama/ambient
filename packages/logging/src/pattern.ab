use ambient.test.{check};
use pkg.{Handler, Log, collect, context, info, keeping, log, within};

/// Patterns as `parse` reads them: each the pieces of text between its
/// wildcards.
pub type Patterns = { include: List<List<string>>, exclude: List<List<string>> };

/// Hands on to `next` the logs whose origin, joined by `:`, matches
/// `pattern`.
///
/// A pattern is names separated by commas or space. `*` in a name
/// stands for any text, and a name after `-` is refused: `app*, -app:db`
/// takes `app` and `app:http` and not `app:db`.
pub fn matching(pattern: string, next: Handler): Handler {
    let patterns = parse(pattern);
    return fn(entry: Log): null {
        if matches(patterns, entry.origin.join_with(":")) {
            next(entry);
        }
        return null;
    };
}

/// The patterns a string of them holds.
pub fn parse(input: string): Patterns {
    let names = input.replace(",", " ").replace("\t", " ").replace("\n", " ").split(" ")
        .filter(fn(name: string): bool => !name.is_empty());
    let refused = fn(name: string): bool => name.starts_with("-");
    return {
        include: names.filter(fn(name: string): bool => !refused(name)).map(pieces),
        exclude: names.filter(refused).map(fn(name: string): List<string> => pieces(after(name, 1))),
    };
}

/// Whether `text` matches one of the patterns to include and none of
/// those to exclude.
pub fn matches(patterns: Patterns, text: string): bool =>
    !patterns.exclude.some(fn(each: List<string>): bool => fits(each, text))
        && patterns.include.some(fn(each: List<string>): bool => fits(each, text));

/// A pattern as the text between its wildcards.
fn pieces(name: string): List<string> => name.split("*");

/// `text` from a position on.
fn after(text: string, start: int): string => text.slice(start, text.length()) ?? "";

/// Whether the whole of `text` is these pieces with any text between
/// each two.
fn fits(pieces: List<string>, text: string): bool {
    let first = pieces.first() ?? "";
    if pieces.length() < 2 {
        return text == first;
    }
    return text.starts_with(first) && follows(pieces.skip(1), after(text, first.length()));
}

/// Whether `text` is any text, then these pieces with any text between
/// each two. Each piece is taken where it is first found, which leaves
/// the most text for the ones after it.
fn follows(pieces: List<string>, text: string): bool {
    let next = pieces.first() ?? "";
    if pieces.length() < 2 {
        return text.ends_with(next);
    }
    match text.find(next) {
        null => { return false; }
        let at => { return follows(pieces.skip(1), after(text, at + next.length())); }
    }
}

fn test_a_wildcard_stands_for_any_text(): null with check {
    let app = parse("app*");
    check!(matches(app, "app"), "nothing is any text");
    check!(matches(app, "app:http"), "what follows is any text");
    check!(!matches(app, "my-app"), "the text before a pattern is not");
    check!(matches(parse("*:db:*"), "app:db:pool"), "a pattern may hold several");
    check!(!matches(parse("a*b*a"), "aba:b"), "the last piece ends the text");
}

fn test_a_refused_name_is_never_taken(): null with check {
    let patterns = parse("app*,  -app:db\t*:worker");
    check!(matches(patterns, "app:http"), "an included name is taken");
    check!(!matches(patterns, "app:db"), "a refused one is not, though it is included too");
    check!(matches(patterns, "jobs:worker"), "names are separated by commas and space");
    check!(!matches(parse(""), "app"), "no pattern takes nothing");
}

fn test_a_handler_hands_on_the_logs_whose_origin_matches(): null with check {
    let kept = cell::<List<Log>>([]);
    provide { [log]: matching("app*, -*:db", keeping(kept)) } => within("app", fn() {
        info("taken", context([]));
        within("db", fn() => info("refused", context([])));
        return null;
    });
    check!(kept.read().map(fn(entry: Log): string => entry.message) == ["taken"], "by its whole origin");
}
