use ambient.json;
use ambient.test;
use ambient.test.{check, unmet};
use ambient.time;
use pkg.{Log, context};
use pkg.level.{self, Level};

/// What a terminal is told to write plainly again.
const RESET: string = "\u{1b}[0m";

/// The codes a terminal writes text under: how heavy it is, or one of
/// its colors.
const DIM: string = "2";
const BRIGHT_WHITE: string = "97";
const BLUE: string = "34";
const GREEN: string = "32";
const YELLOW: string = "33";
const RED: string = "31";
const BOLD_RED: string = "1;31";

/// A log made at the moment `at` as a terminal that has the eight ANSI
/// colors shows it: when, how severe, the message, its context if it
/// has any, and where it came from if anywhere. Whether what it is
/// written to is such a terminal is for the program to find out.
pub fn line(entry: Log, at: int): string {
    let stamp = paint(DIM, clock(at));
    // A message of several lines keeps its later ones under its first.
    let message = entry.message.replace("\n", "\n${stamp}       ");
    let context = entry.context.size() > 0 ? [json.write(entry.context)] : [];
    let origin = entry.origin.is_empty() ? [] : [paint(DIM, entry.origin.join_with(":"))];
    return ([stamp, label(entry.level), message] + context + origin).join_with(" ");
}

/// The time of day of a moment, in UTC. Someone watching a terminal
/// knows what day it is.
fn clock(moment: int): string {
    let at = time.date(moment);
    let wide = fn(value: int, width: int): string => value.to_text().pad_start(width, "0");
    return "[${wide(at.hour, 2)}:${wide(at.minute, 2)}:${wide(at.second, 2)}.${wide(at.millisecond, 3)}]";
}

/// A level in its color, as wide as the widest so that messages line up.
fn label(of: Level): string =>
    match of {
        level.trace => paint(BRIGHT_WHITE, "TRACE"),
        level.debug => paint(BLUE, "DEBUG"),
        level.info => paint(GREEN, "INFO") + " ",
        level.warn => paint(YELLOW, "WARN") + " ",
        level.error => paint(RED, "ERROR"),
        level.fatal => paint(BOLD_RED, "FATAL"),
    };

/// `text` as a terminal writes it under a code. What follows is
/// written plainly again.
fn paint(code: string, text: string): string => "${RESET}\u{1b}[${code}m${text}${RESET}";

#[test.case]
fn a_log_is_a_line_for_a_terminal(): null with unmet {
    let entry = { level: level.warn, message: "up\nand running", origin: ["app"], context: context([]) };
    let stamp = paint(DIM, "[01:02:03.004]");
    let expected = "${stamp} ${paint(YELLOW, "WARN")}  up\n${stamp}       and running ${paint(DIM, "app")}";
    check(line(entry, 3723004) == expected, "a later line of a message is under the first");
}
