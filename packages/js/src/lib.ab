/// What a JavaScript target starts from: a target that binds nothing
/// and is built by `bundle`. A browser's target or Node's extends it,
/// and binds its own abilities to externs whose native side is
/// JavaScript.
///
/// A package keeps the JavaScript of its externs in a directory `js`
/// that its manifest lists: a file for each module that declares one,
/// at the module's path, which exports a function for each extern by
/// its name. An extern annotated with `binding` needs none: the build
/// writes its function.
import ambient.build;
import ambient.tree;
import ambient.build.{Build, Annotation, Compiled, Extern, File, Files, Word};
import ambient.errors.{fail, throw};
import ambient.tree.{Reference, Type};
import pkg.glue;
import pkg.glue.{Built, Signature};
import pkg.types;
import ambient.Error;

/// The world of a program a JavaScript host runs, before anything is
/// bound in it.
pub target host built by bundle {}

/// The key of an annotation on an extern whose native side is
/// something JavaScript already has, so that it needs no JavaScript of
/// its own: the build writes its function from what it takes. The
/// value says what the extern is:
///
/// - `"console.log"`: a call of a function, by its path from the
///   global object.
/// - `{ get: "document.title" }`: what is at such a path.
/// - `{ new: "URL" }`: a new object of the class at such a path.
/// - `{ method: "append" }`: a call of a method of the first thing the
///   extern takes, with the rest.
/// - `{ property: "href" }`: a property of the first thing it takes,
///   and `{ set: "href" }` the same put to the second.
///
/// - `{ build: "digest" }`: the digest of the program's own module,
///   which nothing knows until the program is built.
///
/// An extern that gives a handle gives what JavaScript gave, held by
/// the host under the handle's brand.
pub tag binding;

/// A build was asked for JavaScript it cannot write.
pub tag unwritable;

/// An extern whose function the build writes, and what its binding
/// says it is.
type Bound = { on: Reference, says: unknown };

/// The externs `from` reaches that are annotated with `binding`.
fn bound(from: Reference): List<Bound> with build.annotations, throw {
    match build.annotations!(from, binding) {
        let error: Error => { return throw!(error); }
        let found: List<Annotation> => {
            return found.map(fn(found: Annotation): Bound =>
                { on: found.on, says: found.value });
        }
    }
}

/// What the build writes for `native`, if it is bound.
fn binding_of(bindings: List<Bound>, native: Extern): Bound | null =>
    bindings.find(fn(bound: Bound): bool => bound.on == native.definition);

fn signature(of: Reference): Signature with build.signature, throw {
    match build.signature!(of) {
        let function: Signature => { return function; }
        let error: Error => { return throw!(error); }
        _ => { return fail(unwritable, "`${of.name}` is no function"); }
    }
}

/// The files of the host that loads a module, which are this
/// package's: see `host/host.js`.
fn runtime(): List<string> => ["host.js", "units.js", "values.js"];

fn file(path: string, text: string): File => { path: path, bytes: text.to_bytes() };

/// The text of a file of this package.
fn read(path: string): string with build.read, throw {
    match build.read!(path) {
        let error: Error => { return throw!(error); }
        let text: string => { return text; }
    }
}

/// The module an extern is declared in, as the path of a file: the
/// library module is `lib`.
fn module_of(native: Extern): string {
    let parts = native.path.split(".");
    let module = parts.take(parts.length() - 1);
    return module.is_empty() ? "lib" : module.join_with("/");
}

/// The name an extern is declared by, which its host code exports.
fn name_of(native: Extern): string => native.path.split(".").last() as string else "";

/// Where a build keeps the host code an extern's function is in.
fn kept(native: Extern): string => "externs/" ++ native.package ++ "/" ++ module_of(native) ++ ".js";

/// The host code of the module an extern is declared in, as its
/// package keeps it.
fn hosted(native: Extern): File with build.host_code, throw {
    match build.host_code!(native.package, "js", module_of(native) ++ ".js") {
        let error: Error => { return throw!(error); }
        let text: string => { return file(kept(native), text); }
    }
}

/// The host code of every module that declares one of `externs`,
/// each once.
fn sources(externs: List<Extern>): Files with build.host_code, throw {
    let none: Files = [];
    return externs.fold(none, fn(found: Files, native: Extern): Files {
        let path = kept(native);
        let held = found.some(fn(file: File): bool => file.path == path);
        return held ? found : found.push(hosted(native));
    });
}

/// `constants.js`: what the runtime defines and the host must agree
/// with, which only the compiler that made the module knows. A word
/// crosses into JavaScript as a `BigInt`.
fn constants(compiled: Compiled): string {
    let word = fn(word: Word): string {
        let name = word.name.to_upper();
        return "export const ${name} = ${word.word}n;";
    };
    let kind = fn(kind: Word): string => "  ${kind.name}: ${kind.word}n,";
    let lines = ["// What the runtime defines and the host must agree with, written by the build."]
        .join(compiled.words.map(word))
        .push("export const Kind = {")
        .join(compiled.kinds.map(kind))
        .push("};");
    return lines.join_with("\n") ++ "\n";
}

/// `program.js`: what loads the module with the function of each
/// extern it reaches, and no other. One that is bound is written
/// here, from what the extern takes.
fn loader(externs: List<Extern>, bindings: List<Bound>, built: Built): string with build.signature, throw {
    let none: List<string> = [];
    let imports = externs.fold(none, fn(lines: List<string>, native: Extern): List<string> {
        let position = lines.length();
        match binding_of(bindings, native) {
            let bound: Bound => {
                let written = glue.written(bound.says, signature(native.definition), built);
                return lines.push("const e${position} = ${written};");
            }
            null => {
                return lines.push("import { ${name_of(native)} as e${position} } from \"./${kept(native)}\";");
            }
        }
    });
    let supplies = externs.fold(none, fn(lines: List<string>, native: Extern): List<string> =>
        lines.push("supply(\"${native.package}\", \"${native.path}\", e${lines.length()});"));
    let lines = ["// Written by the build of this program.", "import { Handle, load } from \"./runtime/host.js\";"]
        .join(imports)
        .join([
            "",
            "export * from \"./runtime/host.js\";",
            "",
            "// The native code of each extern the program reaches, by package and path.",
            "const natives = {};",
            "const supply = (pkg, path, run) => ((natives[pkg] ??= {})[path] = run);",
        ])
        .join(supplies)
        .join([
            "",
            "/**",
            " * Loads the program, which `run` then runs. The module is fetched from",
            " * beside this file unless `source` is its bytes or a response that",
            " * carries them. Native code in `over`, by package and path, is used in",
            " * place of the program's own.",
            " */",
            "export function start(source, over = {}) {",
            "  const offered = { ...natives };",
            "  for (const [pkg, paths] of Object.entries(over)) {",
            "    offered[pkg] = { ...offered[pkg], ...paths };",
            "  }",
            "  const module = source ?? fetch(new URL(\"./program.wasm\", import.meta.url));",
            "  return load(module, offered);",
            "}",
        ]);
    return lines.join_with("\n") ++ "\n";
}

/// `program.d.ts`: the types of what `program.js` exports, for a host
/// written in TypeScript. The program's `run` takes what its entry
/// takes, and each extern says what its JavaScript is handed.
fn declarations(entry: Reference, externs: List<Extern>): string with build.signature, throw {
    let main = signature(entry);
    let natives = externs.map(fn(native: Extern): string {
        let takes = signature(native.definition);
        return "  /** `${native.path}` of package `${native.package}`. */\n"
            ++ "  \"${native.package}/${native.path}\": (${types.taken(takes.function)}) => ${types.written(takes.returns)};";
    });
    let lines = [
        "// Written by the build of this program.",
        "",
        "/** The program, loaded: `run` runs its entry. */",
        "export interface Program {",
        "  run(${types.taken(main.function)}): Promise<${types.written(main.returns)}>;",
        "}",
        "",
        "/** What the JavaScript of each extern the program reaches is handed, and gives. */",
        "export interface Externs {",
    ]
        .join(natives)
        .join([
            "}",
            "",
            "/** Native code by package and path, to use in place of the program's own. */",
            "export type Natives = { [pkg: string]: { [path: string]: (...given: any[]) => unknown } };",
            "",
            "export function start(",
            "  source?: BufferSource | Response | Promise<Response>,",
            "  over?: Natives,",
            "): Promise<Program>;",
        ]);
    return lines.join_with("\n") ++ "\n";
}

/// A program for a JavaScript host: the module, the host that loads
/// it, the JavaScript of each extern it reaches, and `program.js`,
/// which puts them together.
pub fn bundle(of: Build): Files
    with build.compile, build.host_code, build.read, build.annotations, build.signature, build.digest, throw
{
    match build.compile!(of.entry, of.target) {
        let error: Error => { return throw!(error); }
        let compiled: Compiled => {
            // An extern is reached from the entry, or bound by the target.
            let bindings = bound(of.target).join(bound(of.entry));
            let written = fn(native: Extern): bool => binding_of(bindings, native) == null;
            let host = runtime().map(fn(name: string): File => file("runtime/" ++ name, read("host/" ++ name)));
            return [{ path: "program.wasm", bytes: compiled.module }]
                .push(file("program.js", loader(compiled.externs, bindings, { digest: build.digest!(compiled.module) })))
                .push(file("program.d.ts", declarations(of.entry, compiled.externs)))
                .push(file("runtime/constants.js", constants(compiled)))
                .join(host)
                .join(sources(compiled.externs.filter(written)));
        }
    }
}
