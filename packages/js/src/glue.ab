/// The JavaScript a build writes for an extern that is bound to
/// something JavaScript has: a function of what the extern takes.
import ambient.errors.{fail, throw};
import ambient.tree;
import ambient.tree.{Brand, Type};
import pkg.{unwritable};

/// What a function or an extern takes and gives.
pub type Signature = { function: List<Type>, returns: Type, takes: List<tree.Ability> };

/// Whether `path` is names with dots between, which is all of a
/// binding that is written into a build as code.
fn is_path(path: string): bool {
    let named = fn(part: string): bool => !part.is_empty() && part.chars().every(fn(char: string): bool {
        let code = char.code() as int else 0;
        return (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
            || (code >= 48 && code <= 57) || char == "_" || char == "$";
    });
    return path.split(".").every(named);
}

fn named(path: string): string with throw =>
    is_path(path) ? path : fail(unwritable, "`${path}` in a `js.binding` is no path of names");

/// What is known of a program only once it is built, which an extern
/// may give: the digest of its module.
pub type Built = { digest: string };

/// The expression a binding says an extern is, of `given`: the names
/// of what the extern takes.
fn does(says: unknown, given: List<string>, built: Built): string with throw {
    let all = given.join_with(", ");
    let on = given.get(0) as string else "undefined";
    let rest = given.skip(1).join_with(", ");
    match says {
        let path: string => { return "${named(path)}(${all})"; }
        let read: { get: string } => { return named(read.get); }
        let made: { new: string } => { return "new ${named(made.new)}(${all})"; }
        let sent: { method: string } => { return "${on}.${named(sent.method)}(${rest})"; }
        let held: { property: string } => { return "${on}.${named(held.property)}"; }
        let put: { set: string } => { return "(${on}.${named(put.set)} = ${rest}, null)"; }
        let late: { build: string } => {
            return late.build == "digest" ? "\"${built.digest}\""
                : fail(unwritable, "a build knows its `digest`, and not its `${late.build}`");
        }
        _ => { return fail(unwritable, "a `js.binding` is a path, one under `get`, `new`, `method`, `property`, or `set`, or `build`"); }
    }
}

/// What an extern gives of what JavaScript `made`: a handle holds it
/// under its brand, and anything else is the value, null if there is
/// none.
fn given_back(returns: Type, made: string): string {
    match returns {
        let handle: { brands: List<Brand>, under: null } => {
            match handle.brands.get(0) {
                let brand: Brand => { return "new Handle(\"${brand.package}\", \"${brand.identity}\", ${made})"; }
                null => { return made; }
            }
        }
        _ => { return "${made} ?? null"; }
    }
}

/// The function that stands for an extern of type `takes` whose
/// binding says `says`. It names exactly what the extern takes, so
/// what the host hands it after that is not handed on.
pub fn written(says: unknown, takes: Signature, built: Built): string with throw {
    let none: List<string> = [];
    let given = takes.function.fold(none, fn(given: List<string>, of: Type): List<string> =>
        given.push("a${given.length()}"));
    return "(${given.join_with(", ")}) => ${given_back(takes.returns, does(says, given, built))}";
}
