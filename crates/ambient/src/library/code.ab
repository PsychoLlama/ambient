import pkg.tree.{any, Arm, Definition, Kind, Entry, Expr, Function, Operation, Pattern, Reference, Said, Shaped, Type};

/// Code that is not yet anywhere: the tree it is, once it is told how
/// many locals are bound around it. Putting code together from these
/// never counts a local by hand, and a piece of code means the same
/// wherever it is put inside what binds its locals.
pub type Code = fn(int): Expr;

/// The tree of code that is not inside any other: what a function
/// gives for a comptime call of it to be spliced.
pub fn build(code: Code): Expr => code(0);

/// Each piece of code as the tree it is under `depth` locals.
fn placed(codes: List<Code>, depth: int): List<Expr> => codes.map(fn(code: Code): Expr => code(depth));

/// A value written out.
pub fn literal(value: null | bool | int | float | string | bytes | Tag): Code =>
    fn(depth: int): Expr => { literal: value };

/// A function or a tag, by reference.
pub fn definition(of: Reference): Code => fn(depth: int): Expr => { definition: of };

/// The text an observer is told an ability is.
pub fn identity(ability: Reference): Code => fn(depth: int): Expr => { identity: ability };

/// A call of `function` with `given`.
pub fn call(function: Code, given: List<Code>): Code =>
    fn(depth: int): Expr => { call: function(depth), given: placed(given, depth) };

/// A call of the handler bound to `ability`.
pub fn perform(ability: Reference, given: List<Code>): Code =>
    fn(depth: int): Expr => { perform: ability, given: placed(given, depth) };

/// A list of what each of `items` gives.
pub fn list(items: List<Code>): Code => fn(depth: int): Expr => { items: placed(items, depth) };

/// A tuple of what each of `members` gives.
pub fn tuple(members: List<Code>): Code => fn(depth: int): Expr => { members: placed(members, depth) };

/// `operation` done on what each of `on` gives.
pub fn operate(operation: Operation, on: List<Code>): Code =>
    fn(depth: int): Expr => { operation: operation, on: placed(on, depth) };

/// An arm of a match that is not yet in one: the arm it is, once it is
/// told how many locals are bound around the match.
pub type Case = fn(int): Arm;

/// How many locals a pattern binds.
fn binds(pattern: Pattern): int {
    match pattern {
        let bound: { bound: Pattern } => { return 1 + binds(bound.bound); }
        let tuple: { tuple: List<Pattern> } => {
            return tuple.tuple.fold(0, fn(sum: int, member: Pattern): int => sum + binds(member));
        }
        let shape: { shape: List<Shaped> } => {
            return shape.shape.fold(0, fn(sum: int, field: Shaped): int => sum + binds(field.matches));
        }
        _ => { return 0; }
    }
}

/// An arm that gives what `body` makes of what `pattern` binds: the
/// code `body` is handed is each binding, in the order the pattern
/// has them.
pub fn arm(pattern: Pattern, body: fn(List<Code>): Code): Case =>
    fn(depth: int): Arm {
        let count = binds(pattern);
        let locals = @range(0, count).map(fn(at: int): Code => local(depth + at)).to_list();
        return { pattern: pattern, gives: body(locals)(depth + count) };
    };

/// What the first of `arms` to match `subject` gives.
pub fn matching(subject: Code, arms: List<Case>): Code =>
    fn(depth: int): Expr => {
        subject: subject(depth),
        arms: arms.map(fn(case: Case): Arm => case(depth)),
    };

/// `then` if `condition` is true, and `otherwise` if not.
pub fn choose(condition: Code, then: Code, otherwise: Code): Code =>
    matching(condition, [
        arm({ equals: true }, fn(bound: List<Code>): Code => then),
        arm({ is: any }, fn(bound: List<Code>): Code => otherwise),
    ]);

/// A record with a field for each name.
pub fn record(fields: List<(string, Code)>): Code =>
    fn(depth: int): Expr => {
        fields: fields.map(fn(named: (string, Code)): Entry {
            let (name, value) = named;
            return { name: name, value: value(depth) };
        }),
    };

/// A record that holds a handler for each ability: what a provide
/// binds.
pub fn handlers(of: List<(Reference, Code)>): Code =>
    fn(depth: int): Expr => {
        fields: of.map(fn(bound: (Reference, Code)): Entry {
            let (ability, handler) = bound;
            return { ability: ability, value: handler(depth) };
        }),
    };

/// What `body` gives with the handlers of `handlers` bound: see
/// [`handlers`].
pub fn providing(handlers: Code, body: Code): Code =>
    fn(depth: int): Expr => { handlers: handlers(depth), body: body(depth) };

/// A definition of the module a tree is the content of, by the name it
/// has there: how one definition of a generated module refers to
/// another.
pub fn beside(name: string, kind: Kind): Reference => { beside: null, name, kind };

/// A record with the fields of `over` and, where it has none of a
/// name, those of `under`.
pub fn merge(under: Code, over: Code): Code =>
    fn(depth: int): Expr => { under: under(depth), over: over(depth) };

/// The field `name` of a record.
pub fn field(of: Code, name: string): Code => fn(depth: int): Expr => { field: name, of: of(depth) };

/// A call of the method `name` of a value with `given`.
pub fn send(of: Code, name: string, given: List<Code>): Code =>
    fn(depth: int): Expr => { method: name, of: of(depth), given: placed(given, depth) };

/// `of`, with `value` said of it to a build under `key`: a reference
/// to a tag, as `comptime tree.reference(tag)` gives one, and plain
/// data. It is how what a comptime call found reaches a tool.
pub fn annotated(key: Reference, value: unknown, of: Code): Code =>
    fn(depth: int): Expr => { annotated: of(depth), key: key, value: value };

/// `value` at the type `to` if the type describes it, and `otherwise`
/// if not.
pub fn cast(value: Code, to: Type, otherwise: Code): Code =>
    fn(depth: int): Expr => { cast: value(depth), to: to, otherwise: otherwise(depth) };

/// The local bound after `depth` others.
fn local(depth: int): Code => fn(inner: int): Expr => { local: depth };

/// What `body` makes of `value`, which is evaluated once and held: the
/// code `body` is handed is the value.
pub fn bind(value: Code, body: fn(Code): Code): Code =>
    fn(depth: int): Expr => { bind: value(depth), body: body(local(depth))(depth + 1) };

/// A function that takes a parameter of each type, and gives what
/// `body` makes of them: the code `body` is handed is the parameters.
pub fn function(params: List<Type>, body: fn(List<Code>): Code): Code =>
    fn(depth: int): Expr {
        let count = params.length();
        let locals = @range(0, count).map(fn(at: int): Code => local(depth + at)).to_list();
        return { function: params, body: body(locals)(depth + count) };
    };

/// A function of one parameter: [`function`], for the common case.
pub fn lambda(param: Type, body: fn(Code): Code): Code =>
    fn(depth: int): Expr => { function: [param], body: body(local(depth))(depth + 1) };

/// A function as a definition, which takes a parameter of each type
/// and `takes` from its caller, and gives what `body` makes of the
/// parameters: what a function gives for `fn name = comptime ...;`.
pub fn define(params: List<Type>, returns: Type, takes: List<Reference>, body: fn(List<Code>): Code): Function {
    let count = params.length();
    let locals = @range(0, count).map(fn(at: int): Code => local(at)).to_list();
    return { generic: [], params, returns, takes, body: body(locals)(count) };
}

/// The type parameter at a position among those of the definition a
/// tree is the content of.
fn parameter(at: int): Type => { parameter: at };

/// A function with a type parameter for each of `bounds`, which is
/// its bound or null: the function `make` gives, which is handed the
/// type each parameter is.
pub fn generic(bounds: List<Type | null>, make: fn(List<Type>): Function): Function {
    let made = make(@range(0, bounds.length()).map(parameter).to_list());
    return { generic: bounds, params: made.params, returns: made.returns, takes: made.takes, body: made.body };
}

/// A public function of a generated module, by the name it has there.
pub fn named(name: string, function: Function): Definition => { name, public: true, function };

/// A public type of a generated module, by the name it has there.
pub fn named_type(name: string, means: Type): Definition => { name, public: true, means, parameters: 0 };

/// A public type of a generated module with `parameters` type
/// parameters: what `means` gives, which is handed the type each is.
pub fn named_generic(name: string, parameters: int, means: fn(List<Type>): Type): Definition =>
    { name, public: true, means: means(@range(0, parameters).map(parameter).to_list()), parameters };

/// A public ability of a generated module, by the name it has there
/// and what it takes and gives.
pub fn named_ability(name: string, takes: List<Type>, returns: Type): Definition =>
    { name, public: true, ability: takes, returns, generic: [] };

/// A public ability of a generated module with a type parameter for
/// each of `bounds`, which is its bound or null: `signature` is
/// handed the type each is, and gives what the ability takes and
/// gives.
pub fn named_generic_ability(name: string, bounds: List<Type | null>, signature: fn(List<Type>): (List<Type>, Type)): Definition {
    let (takes, returns) = signature(@range(0, bounds.length()).map(parameter).to_list());
    return { name, public: true, ability: takes, returns, generic: bounds };
}

/// A public tag of a generated module, by the name it has there.
pub fn named_tag(name: string): Definition => { name, public: true, tag: null };

/// A public brand of a generated module, by the name it has there.
pub fn named_brand(name: string): Definition => { name, public: true, brand: null };

/// A public extern function of a generated module that performs
/// nothing: its name there, what it takes and gives, and what is said
/// of it to a build, which is how a target's tool comes to write its
/// native side.
pub fn named_extern(name: string, takes: List<Type>, returns: Type, said: List<Said>): Definition =>
    { name, public: true, extern: takes, returns, takes: [], said };
