use pkg.errors;
use pkg.Error;
use pkg.tree.{Reference, Type};

/// Nothing of the package is at the path.
pub tag not_found;

/// The path names what is not a file of the package.
pub tag denied;

/// The text of a file of the package. A path is from the directory of
/// the package the call is written in.
pub ability read(path: string): string | Error;

/// What a file of the package holds, text or not.
pub ability read_bytes(path: string): bytes | Error;

/// The names of what a directory of the package holds, in order.
pub ability list(path: string): List<string> | Error;

/// What was asked for could not be made; the message says why.
pub tag failed;

/// A file a build gives: where it goes, from the directory the build
/// is written into, and what it holds.
pub type File = { path: string, bytes: bytes };

/// What a tool that builds a program gives: the files of the build.
pub type Files = List<File>;

/// What a tool that builds a program is handed: the entry, the target
/// it is built under, and the files the build steps gave. A build
/// step is handed the same, with no files: it sees no other's.
pub type Build = { entry: Reference, target: Reference, files: Files };

/// An extern a compiled program imports: the ID of the package that
/// declares it, its module path and name, which are what a host finds
/// its native code by, and its definition.
pub type Extern = { package: string, path: string, definition: Reference };

/// A number the runtime gives a meaning, by a name for it.
pub type Word = { name: string, word: int };

/// A program compiled as a WebAssembly module: the module, the
/// externs it imports, and what the runtime defines that its host
/// must agree with. `words` are the words with a meaning of their
/// own, the modes of a context, the fault native code that fails is,
/// and what native code is told a task left a wait by; `kinds` are
/// what kind of value a word is.
pub type Compiled = { module: bytes, externs: List<Extern>, words: List<Word>, kinds: List<Word> };

/// An entry compiled under a target, for a host that supplies what
/// the target binds.
pub ability compile(entry: Reference, target: Reference): Compiled | Error;

/// The text of a file of host code: one of the package of an ID, for
/// a platform, at a path from the directory the package keeps that
/// platform's host code in, which is named for it.
pub ability host_code(package: string, platform: string, path: string): string | Error;

/// An annotation: the definition it is on, and its value, which is
/// whatever the package that owns its key says one is.
pub type Annotation = { on: Reference, value: unknown };

/// The annotations of a key that a definition reaches: its own, and
/// those of every definition it refers to. They are in the order a
/// walk from it first meets them, which is the same on every build.
pub ability annotations(from: Reference, key: Tag): List<Annotation> | Error;

/// The type a function or an extern has: what it takes, what it
/// gives, and the abilities of its row. One with type parameters has
/// none to give.
pub ability signature(of: Reference): Type | Error;

/// A module: the package it is of, named as a reference names it, and
/// its path.
pub type Module = { package: string, path: List<string> };

/// What a command covers, which it hands the tool behind it: the
/// packages, their modules, and text a name must hold to be covered.
pub type Selection = { packages: List<string>, modules: List<Module>, name: string };

/// Something wrong with a definition, in words for whoever wrote it.
pub type Diagnostic = { on: Reference, message: string };

/// What a lint gives: a function of the build that takes a `Selection`.
/// A package's manifest lists the lints checking it runs.
pub type Diagnostics = List<Diagnostic>;

/// The modules of a package, each by its path: the package is named
/// as a reference names it.
pub ability modules(package: string): List<List<string>>;

/// The definitions of a module, public and not, in the order they are
/// written.
pub ability definitions(package: string, module: List<string>): List<Reference> | Error;

/// The doc comment of a definition, if it has one.
pub ability doc(of: Reference): string | null | Error;

/// The definitions a definition reaches, itself first, in the order a
/// walk from it first meets them.
pub ability reach(from: Reference): List<Reference> | Error;

/// What a run of a function gave.
pub type Ran = { gave: unknown };

/// Runs a function of the build with what it is `given`, as a run of
/// its own: it is kept apart from the run that asked, and made again
/// only when what it asked has changed. It takes only the build
/// abilities its own package is granted.
pub ability run(function: Reference, given: List<unknown>): Ran | Error;

/// The bytes at a URL, which are those of a digest: SHA-256, in
/// hexadecimal. What was fetched once is kept, and never fetched
/// again.
pub ability fetch(url: string, digest: string): bytes | Error;

/// Keeps bytes for the build, and gives their digest: what an
/// annotation holds in place of a file, so no tree holds one.
pub ability keep(bytes: bytes): string;

/// The bytes kept or fetched under a digest.
pub ability kept(digest: string): bytes | Error;

/// The digest of bytes, as `fetch` is given one.
pub ability digest(of: bytes): string;

/// The time, in milliseconds since 1970. It is never what it was, so
/// a run that asks is made again on every build.
pub ability now(): int;

extern handler compiling for compile;
extern handler moduling for modules;
extern handler defining for definitions;
extern handler reaching for reach;
extern handler documenting for doc;
extern handler running for run;
extern handler fetching for fetch;
extern handler keeping for keep;
extern handler holding for kept;
extern handler digesting for digest;
extern handler timing for now;
extern handler signing for signature;
extern handler annotating for annotations;
extern handler hosting for host_code;
extern handler thrown for errors.throw;
extern handler reading for read;
extern handler reading_bytes for read_bytes;
extern handler listing for list;

/// The world of a comptime call and of a tool: what a build may be
/// granted. Each is a question a build can ask again, so a run is
/// made again only when an answer has changed. An error that is
/// thrown and not caught fails the build.
pub target world {
    compile: compiling,
    annotations: annotating,
    signature: signing,
    modules: moduling,
    definitions: defining,
    reach: reaching,
    doc: documenting,
    run: running,
    fetch: fetching,
    keep: keeping,
    kept: holding,
    digest: digesting,
    now: timing,
    host_code: hosting,
    errors.throw: thrown,
    read: reading,
    read_bytes: reading_bytes,
    list: listing,
}
