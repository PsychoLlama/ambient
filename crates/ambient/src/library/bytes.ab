use pkg.intrinsics;

/// How many bytes there are.
pub fn length(self: bytes): int => intrinsics.length(self);

/// The byte at a position, from 0 to 255, or null if there is none.
pub fn get(self: bytes, position: int): int | null => intrinsics.get(self, position);

/// These bytes followed by `other`.
pub fn join(self: bytes, other: bytes): bytes => intrinsics.join(self, other);

/// The bytes between two positions, or null if they are out of range or
/// out of order.
pub fn slice(self: bytes, start: int, end: int): bytes | null => intrinsics.slice(self, start, end);

/// Whether there are no bytes.
pub fn is_empty(self: bytes): bool => intrinsics.length(self) == 0;

/// The string these bytes encode as UTF-8, or null if they encode none.
pub fn to_text(self: bytes): string | null => intrinsics.to_text(self);

/// The position `part` first begins at, or null if it is not there.
pub fn find(self: bytes, part: bytes): int | null => find_from(self, part, 0);

fn find_from(held: bytes, part: bytes, at: int): int | null {
    let end = at + intrinsics.length(part);
    if intrinsics.length(held) < end {
        return null;
    }
    // A first byte that differs settles it without making a slice.
    if intrinsics.get(held, at) == intrinsics.get(part, 0) && intrinsics.slice(held, at, end) == part {
        return at;
    }
    return find_from(held, part, at + 1);
}

/// Whether `part` is anywhere in the bytes.
pub fn contains(self: bytes, part: bytes): bool => find(self, part) != null;

/// The pieces of the bytes between each `separator`. A separator that
/// holds nothing separates nothing.
///
/// Text split on a byte below 128, such as a line's ending, splits
/// whole characters: no other character's encoding holds one.
pub fn split(self: bytes, separator: bytes): List<bytes> {
    if intrinsics.length(separator) == 0 {
        return [self];
    }
    return split_into(self, separator, []);
}

fn split_into(held: bytes, separator: bytes, pieces: List<bytes>): List<bytes> {
    match find(held, separator) {
        null => { return intrinsics.push(pieces, held); }
        let at => {
            let rest = from(held, at + intrinsics.length(separator));
            return split_into(rest, separator, intrinsics.push(pieces, before(held, at)));
        }
    }
}

/// What is left of the bytes from a position on, or nothing if the
/// position is not one.
fn from(held: bytes, start: int): bytes => intrinsics.slice(held, start, intrinsics.length(held)) ?? 0x[];

/// What is in the bytes before a position, or nothing if the position
/// is not one.
fn before(held: bytes, end: int): bytes => intrinsics.slice(held, 0, end) ?? 0x[];

/// Each byte, in order.
pub fn iter(self: bytes): Iterator<int> =>
    intrinsics.range(0, intrinsics.length(self)).map(fn(at: int): int => intrinsics.get(self, at) ?? 0);

/// Each byte as a member of a list.
pub fn to_list(self: bytes): List<int> => iter(self).to_list();

/// Each byte as two hexadecimal digits, in lower case.
pub fn hex(self: bytes): string =>
    iter(self).map(fn(byte: int): string => digit(byte / 16) + digit(byte % 16)).to_list().join_with("");

fn digit(value: int): string => intrinsics.slice("0123456789abcdef", value, value + 1) ?? "";

/// The bytes a list holds, or null if a member is not from 0 to 255.
pub fn of(members: List<int>): bytes | null => intrinsics.to_bytes(members);

/// The bytes that hexadecimal digits say, two to a byte and in either
/// case, or null if the text is not that.
pub fn from_hex(text: string): bytes | null {
    let digits = text.to_bytes().iter().map(hex_value).to_list();
    if digits.contains(null) || digits.length() % 2 == 1 {
        return null;
    }
    let digit = fn(at: int): int => digits.get(at) ?? 0;
    let byte = fn(at: int): int => digit(at * 2) * 16 + digit(at * 2 + 1);
    return intrinsics.to_bytes(intrinsics.range(0, digits.length() / 2).map(byte).to_list());
}

/// The number a hexadecimal digit stands for, by its code.
fn hex_value(code: int): int | null {
    if 47 < code && code < 58 {
        return code - 48;
    }
    if 64 < code && code < 71 {
        return code - 55;
    }
    if 96 < code && code < 103 {
        return code - 87;
    }
    return null;
}
