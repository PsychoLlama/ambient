use pkg.intrinsics;

/// The float nearest this integer.
pub fn to_float(self: int): float => intrinsics.to_float(self);

/// The character whose scalar value this integer is, or null if it is
/// the value of none.
pub fn to_character(self: int): string | null => intrinsics.character(self);

/// This integer in decimal.
pub fn to_text(self: int): string => intrinsics.to_text(self);

/// This integer with the other sign, which `-` before a value means.
pub fn negate(self: int): int => 0 - self;

/// This integer without its sign.
pub fn abs(self: int): int {
    if self < 0 {
        return 0 - self;
    }
    return self;
}

/// The lesser of this integer and `other`.
pub fn min(self: int, other: int): int {
    if other < self {
        return other;
    }
    return self;
}

/// The greater of this integer and `other`.
pub fn max(self: int, other: int): int {
    if self < other {
        return other;
    }
    return self;
}
