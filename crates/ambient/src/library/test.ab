use pkg.build;
use pkg.build.{Annotation, Module, Selection};
use pkg.errors;
use pkg.intrinsics;
use pkg.tree.{Reference};
use pkg.Error;

/// What a test relied on that did not hold. One that says more holds
/// more: what was `found` and what was `expected` are reported beside
/// it, as [`equal`] gives them.
pub type Failure = { what: string };

/// Says that something a test relies on did not hold. A test goes on
/// after it, so it reports every one. Every assertion is a function
/// over this.
pub ability unmet(failure: Failure): null;

/// Fails the test unless `holds`, saying `what` should have.
pub fn check(holds: bool, what: string): null with unmet {
    if !holds {
        unmet!({ what: what });
    }
}

/// Fails the test unless `found` is `expected`, saying both.
pub fn equal<T>(found: T, expected: T, what: string): null with unmet {
    if !(found == expected) {
        unmet!({ what: what, found: found, expected: expected });
    }
}

/// What a test came to: each check that did not hold, in the order
/// they were made, and the error that ended it, if one did. A fault
/// ends it as an error does. It is plain data, and names nothing: the
/// error's trace is of hashes, which whoever reports it names.
pub type Outcome = { unmet: List<Failure>, error: Error | null };

/// Runs `test`, and gives what it came to. It is what a test is run
/// through, so what `test` takes of `unmet` and `throw` is answered
/// here, and nothing else is.
pub fn outcome(test: fn(): unknown with unmet, errors.throw): Outcome {
    let failures = intrinsics.cell::<List<Failure>>([]);
    let ran = fn(): null with errors.throw {
        provide {
            [unmet](failure) {
                failures.update(fn(told: List<Failure>): List<Failure> => told.push(failure));
            }
        } {
            test();
        }
        return null;
    };
    let ended = match intrinsics.contain(fn() => errors.catch(ran)) {
        let error: Error => error,
        _ => null,
    };
    return { unmet: failures.read(), error: ended };
}

/// The world of a test: nothing. What `outcome` provides is all a
/// test is given, and a test that needs more provides it.
pub target runner {}

/// A group of tests: a module, or any grouping a library makes. It may
/// be in a group of its own.
pub type Group = { name: string, group: Group | null };

/// A test, as finding gives one: its name, the group it is in, and the
/// function that is the test, which takes nothing. Neither the name
/// nor the group is part of what keeps its outcome.
pub type Test = { name: string, group: Group | null, function: Reference };

/// What finding tests gives: the tests of a selection, in order. A
/// package's manifest lists the functions that find its tests, each
/// one of `fn(build.Selection): Tests`.
pub type Tests = List<Test>;

/// What a function that takes nothing is annotated with to be a test:
/// `#[test.case]`. What `annotated` finds.
pub tag case;

/// The group a module's tests are in: the module, by its package and
/// its path, or by its package alone if it is the library module.
pub fn module(of: Module): Group {
    let path = of.path.join_with(".");
    return { name: path == "" ? of.package : of.package.join(":").join(path), group: null };
}

/// A test of the module `at`: the definition `function`, by its name.
fn found(at: Module, function: Reference): Test =>
    { name: function.name, group: module(at), function };

/// The tests of a selection annotated as a `case`, in the order their
/// modules and definitions are written. A package that lists no way to
/// find its tests has this one.
pub fn annotated(of: Selection): Tests with build.annotated {
    return of.modules.fold([], fn(tests: Tests, module: Module): Tests {
        let said = match build.annotated!(module, case) {
            let said: List<Annotation> => said,
            _ => [],
        };
        return tests.join(said.map(fn(annotation: Annotation): Test => found(module, annotation.on)));
    });
}
