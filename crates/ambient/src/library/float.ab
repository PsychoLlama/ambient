use pkg.intrinsics;

/// This float with its fraction dropped, or null if that is no integer.
pub fn to_int(self: float): int | null => intrinsics.to_int(self);

/// The shortest decimal that reads back as this float.
pub fn to_text(self: float): string => intrinsics.to_text(self);

/// This float with the other sign, which `-` before a value means.
pub fn negate(self: float): float => -1.0 * self;

/// This float without its sign.
pub fn abs(self: float): float => self < 0.0 ? negate(self) : self;

/// The lesser of this float and `other`.
pub fn min(self: float, other: float): float => other < self ? other : self;

/// The greater of this float and `other`.
pub fn max(self: float, other: float): float => self < other ? other : self;

/// The greatest whole number that is not more than this float. One too
/// large to have a fraction, or that is no number, is itself.
pub fn floor(self: float): float {
    let whole: int = intrinsics.to_int(self) else {
        null => { return self; }
    };
    let near = intrinsics.to_float(whole);
    return self < near ? near - 1.0 : near;
}

/// The least whole number that is not less than this float.
pub fn ceil(self: float): float => negate(floor(negate(self)));

/// The whole number nearest this float; halfway between two, the one
/// further from zero.
pub fn round(self: float): float => self < 0.0 ? ceil(self - 0.5) : floor(self + 0.5);
