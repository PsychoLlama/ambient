use pkg.intrinsics;

/// How many members the list has.
pub fn length<T>(self: List<T>): int => intrinsics.length(self);

/// The members of this list followed by those of `other`.
pub fn join<T>(self: List<T>, other: List<T>): List<T> => intrinsics.join(self, other);

/// The members between two positions, or null if they are out of range
/// or out of order.
pub fn slice<T>(self: List<T>, start: int, end: int): List<T> | null => intrinsics.slice(self, start, end);

/// An iterator over the members, in order.
pub fn iter<T>(self: List<T>): Iterator<T> => intrinsics.iterate(self);

/// The member at a position, or null if there is none.
pub fn get<T>(self: List<T>, position: int): T | null => intrinsics.get(self, position);

/// This list with `member` after the others.
pub fn push<T>(self: List<T>, member: T): List<T> => intrinsics.push(self, member);

/// Whether the list has no members.
pub fn is_empty<T>(self: List<T>): bool => intrinsics.length(self) == 0;

/// The first member, or null if there is none.
pub fn first<T>(self: List<T>): T | null => intrinsics.get(self, 0);

/// The last member, or null if there is none.
pub fn last<T>(self: List<T>): T | null => intrinsics.get(self, intrinsics.length(self) - 1);

/// What `f` makes of each member.
pub fn map<T, U>(self: List<T>, f: fn(item: T): U): List<U> => intrinsics.iterate(self).map(f).to_list();

/// The members `keep` takes.
pub fn filter<T>(self: List<T>, keep: fn(item: T): bool): List<T> => intrinsics.iterate(self).filter(keep).to_list();

/// What `f` makes of `initial` and each member in turn.
pub fn fold<T, A>(self: List<T>, initial: A, f: fn(total: A, item: T): A): A => intrinsics.iterate(self).fold(initial, f);

/// Calls `f` with each member, for what it does.
pub fn each<T, R>(self: List<T>, f: fn(item: T): R): null => intrinsics.iterate(self).each(f);

/// The members in the opposite order.
pub fn reverse<T>(self: List<T>): List<T> => reversed(self, intrinsics.length(self), []);

fn reversed<T>(members: List<T>, left: int, into: List<T>): List<T> {
    if left < 1 {
        return into;
    }
    match intrinsics.step(intrinsics.iterate(members).skip(left - 1)) {
        null => { return into; }
        (let member, _) => { return reversed(members, left - 1, intrinsics.push(into, member)); }
    }
}

/// The members in order, where `before` says whether one comes before
/// another. Members neither of which comes before the other keep the
/// order they had.
pub fn sort_by<T>(self: List<T>, before: fn(left: T, right: T): bool): List<T> {
    let count = intrinsics.length(self);
    if count < 2 {
        return self;
    }
    let middle = count / 2;
    let left = sort_by(intrinsics.iterate(self).take(middle).to_list(), before);
    let right = sort_by(intrinsics.iterate(self).skip(middle).to_list(), before);
    return merge(intrinsics.iterate(left), intrinsics.iterate(right), before, []);
}

/// Two sorted runs as one, after `into`.
fn merge<T>(left: Iterator<T>, right: Iterator<T>, before: fn(left: T, right: T): bool, into: List<T>): List<T> {
    match intrinsics.step(left) {
        null => { return intrinsics.join(into, right.to_list()); }
        (let a, let more_left) => {
            match intrinsics.step(right) {
                null => { return intrinsics.join(into, left.to_list()); }
                (let b, let more_right) => {
                    if before(b, a) {
                        return merge(left, more_right, before, intrinsics.push(into, b));
                    }
                    return merge(more_left, right, before, intrinsics.push(into, a));
                }
            }
        }
    }
}

/// The strings of the list as one, with `separator` between each two.
pub fn join_with(self: List<string>, separator: string): string {
    match intrinsics.step(intrinsics.iterate(self)) {
        null => { return ""; }
        (let head, let rest) => {
            return rest.fold(head, fn(joined: string, piece: string): string => joined + separator + piece);
        }
    }
}

/// The integers of the list added up.
pub fn sum(self: List<int>): int => intrinsics.iterate(self).fold(0, fn(total: int, member: int): int => total + member);

/// Whether `member` is one of the members.
pub fn contains<T>(self: List<T>, member: T): bool =>
    intrinsics.iterate(self).some(fn(each: T): bool => each == member);

/// The first member `wanted` takes, or null if there is none.
pub fn find<T>(self: List<T>, wanted: fn(item: T): bool): T | null => intrinsics.iterate(self).find(wanted);

/// Whether `holds` takes any member.
pub fn some<T>(self: List<T>, holds: fn(item: T): bool): bool => intrinsics.iterate(self).some(holds);

/// Whether `holds` takes every member.
pub fn every<T>(self: List<T>, holds: fn(item: T): bool): bool => intrinsics.iterate(self).every(holds);

/// The first `count` members, or all of them if there are fewer.
pub fn take<T>(self: List<T>, count: int): List<T> => intrinsics.iterate(self).take(count).to_list();

/// The members after the first `count`.
pub fn skip<T>(self: List<T>, count: int): List<T> => intrinsics.iterate(self).skip(count).to_list();
