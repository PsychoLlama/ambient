/// The type no value has.
pub tag none;
/// The type every value has.
pub tag any;
/// The type of null.
pub tag nil;
pub tag boolean;
pub tag integer;
/// The type of a float.
pub tag number;
/// The type of a string.
pub tag text;
/// The type of bytes.
pub tag binary;
/// The type of every tag.
pub tag tagged;

/// A type with nothing inside it.
pub type Primitive = none | any | nil | boolean | integer | number | text | binary | tagged;

/// A definition, as what a tree refers to it by. A comptime function is
/// handed one for a parameter of this type, when its call names a
/// definition. It says which definition outright, so nothing in a tree
/// is looked up by a name where the tree lands.
///
/// A definition of a generated module refers to another of the same
/// module as `beside` it, by the name it has there: the function that
/// gives a module does not know where its call is written.
pub type Reference =
    { package: string, module: List<string>, name: string, kind: Kind }
    | { beside: null, name: string, kind: Kind };

/// What kind of definition a reference is to.
pub type Kind = "type" | "value" | "ability" | "key";

/// A brand, as a type's tree refers to it: where it is declared.
pub type Brand = { package: string, identity: string };

/// The reference of the definition a call names: `comptime
/// tree.reference(name)` is how a function comes by one for what its
/// own module can name.
pub fn reference(of: Reference): Reference => of;

/// An ability of a function type's row: which it is, and the types of
/// what it takes and gives.
pub type Ability = { ability: Reference, function: List<Type>, returns: Type };

/// The tree of the type a call names: `comptime tree.type_of(Name)`
/// is how a function comes by one for a type its own module can name.
pub fn type_of(of: Type): Type => of;

/// A field of a record type: its name, and the type of what it holds.
pub type Field = { name: string, holds: Type };

/// A type, as data: what a comptime function is handed for a
/// parameter of this type, when its call names a type.
///
/// - `literal` is the type of one value, which it holds.
/// - `named` is a type that refers to itself, where it does: the tree
///   of such a type is its definition, with the type named inside it.
///   `applied` is one with type arguments, `to` each of which it is
///   applied.
/// - `parameter` is a type parameter of the definition the tree is the
///   content of, by its position among them.
/// - `function` is the types of the parameters; `takes` is the
///   abilities of its row. A function named to a call is handed as the
///   type it has.
/// - `brands` are the brands on the type `under` them; a handle is
///   brands on nothing.
pub type Type =
    Primitive
    | { literal: bool | int | float | string | bytes | Tag }
    | { list: Type }
    | { mutable: Type }
    | { iterator: Type }
    | { tuple: List<Type> }
    | { record: List<Field> }
    | { union: List<Type> }
    | { named: Reference }
    | { applied: Reference, to: List<Type> }
    | { parameter: int }
    | { function: List<Type>, returns: Type, takes: List<Ability> }
    | { brands: List<Brand>, under: Type | null };

/// A field of a record that an expression makes: its name, or the
/// ability it holds the handler of, and the expression of what it
/// holds.
pub type Entry = { name: string, value: Expr } | { ability: Reference, value: Expr };

/// An operation, by the word for it: `@length(list)` is `length`, and
/// `left + right` is `add`.
pub type Operation =
    "add" | "subtract" | "multiply" | "divide" | "remainder" | "less" | "equal"
    | "length" | "get" | "push" | "join" | "slice"
    | "to_int" | "to_float" | "to_text" | "to_bytes" | "code" | "character"
    | "iterator" | "iterate" | "range" | "step" | "gather" | "race";

/// A field of a record pattern: its name, and what the field must
/// match.
pub type Shaped = { name: string, matches: Pattern };

/// A pattern, as data: what an arm of a match tests its subject by.
///
/// - `is` matches a value the type describes: `tree.any`, anything.
/// - `equals` matches one value.
/// - `bound` matches what the pattern inside it does, and binds it:
///   the local after those bound around the match and those the
///   pattern bound before it.
/// - `tuple` matches a tuple of as many members, each matching, and
///   `shape` a record with at least these fields.
pub type Pattern =
    { is: Type }
    | { equals: bool | int | float | string | bytes | Tag }
    | { bound: Pattern }
    | { tuple: List<Pattern> }
    | { shape: List<Shaped> };

/// An arm of a match: what it tests the subject by, and what the
/// match gives if that is the first to match.
pub type Arm = { pattern: Pattern, gives: Expr };

/// An expression, as data: what a function gives for a comptime call
/// of it to be spliced as code. It names nothing where it is spliced.
///
/// - `definition` is a function or a tag, by reference.
/// - `function` is a function written in place, by the types of its
///   parameters, and `bind` holds a value for the extent of `body`.
/// - `local` is what one of those bound, counted from the outermost
///   the expression is inside: a function's first parameter is as many
///   as were bound around the function.
/// - `perform` calls the handler bound to an ability, and `identity`
///   is the text an observer is told the ability is.
/// - `cast` is the value at the type `to` if the type describes it,
///   and `otherwise` if not.
/// - `method` is called on the value `of`, as `value.method(...)` is.
/// - `handlers` is a record of them, bound for the extent of `body`:
///   a provide.
/// - `subject` is matched against each of `arms` in turn, and
///   `operation` is done `on` its operands.
pub type Expr =
    { literal: null | bool | int | float | string | bytes | Tag }
    | { definition: Reference }
    | { local: int }
    | { identity: Reference }
    | { call: Expr, given: List<Expr> }
    | { perform: Reference, given: List<Expr> }
    | { items: List<Expr> }
    | { members: List<Expr> }
    | { fields: List<Entry> }
    | { field: string, of: Expr }
    | { method: string, of: Expr, given: List<Expr> }
    | { cast: Expr, to: Type, otherwise: Expr }
    | { bind: Expr, body: Expr }
    | { handlers: Expr, body: Expr }
    | { subject: Expr, arms: List<Arm> }
    | { operation: Operation, on: List<Expr> }
    | { function: List<Type>, body: Expr };

/// A function as a definition: its type parameters, each by its bound
/// or by null if it has none; what it takes, what it gives, the
/// abilities it takes from its caller, and its body, in which the
/// parameters are the locals bound first. A function definition whose
/// whole content is a comptime call is the one such a tree stands for.
pub type Function = {
    generic: List<Type | null>,
    params: List<Type>,
    returns: Type,
    takes: List<Reference>,
    body: Expr,
};

/// A definition a generated module has: its name, whether other
/// modules may use it, and what it is. That is a function, the type
/// the name means and how many type parameters it has, an ability by
/// what it takes and gives, or a tag, of which there is no more to
/// say.
pub type Definition =
    { name: string, public: bool, function: Function }
    | { name: string, public: bool, means: Type, parameters: int }
    | { name: string, public: bool, ability: List<Type>, returns: Type }
    | { name: string, public: bool, tag: null };

/// What a call gives for a module whose whole content it is.
pub type Module = List<Definition>;
