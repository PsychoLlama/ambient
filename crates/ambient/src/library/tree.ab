/// The type no value has.
pub tag none;
/// The type every value has.
pub tag any;
/// The type of null.
pub tag nil;
pub tag boolean;
pub tag integer;
/// The type of a float.
pub tag number;
/// The type of a string.
pub tag text;
/// The type of bytes.
pub tag binary;
/// The type of every tag.
pub tag tagged;

/// A type with nothing inside it.
pub type Primitive = none | any | nil | boolean | integer | number | text | binary | tagged;

/// A definition, as what a tree refers to it by. A comptime function is
/// handed one for a parameter of this type, when its call names a
/// definition. It says which definition outright, so nothing in a tree
/// is looked up by a name where the tree lands.
pub type Reference = {
    package: string,
    module: List<string>,
    name: string,
    kind: "type" | "value" | "ability" | "key",
};

/// A brand, as a type's tree refers to it: where it is declared.
pub type Brand = { package: string, identity: string };

/// The reference of the definition a call names: `comptime
/// tree.reference(name)` is how a function comes by one for what its
/// own module can name.
pub fn reference(of: Reference): Reference => of;

/// A field of a record type: its name, and the type of what it holds.
pub type Field = { name: string, holds: Type };

/// A type, as data: what a comptime function is handed for a
/// parameter of this type, when its call names a type.
///
/// - `literal` is the type of one value, which it holds.
/// - `named` is a type that refers to itself, where it does: the tree
///   of such a type is its definition, with the type named inside it.
/// - `function` is the types of the parameters; `takes` is the
///   abilities of its row.
/// - `brands` are the brands on the type `under` them; a handle is
///   brands on nothing.
pub type Type =
    Primitive
    | { literal: bool | int | float | string | bytes | Tag }
    | { list: Type }
    | { mutable: Type }
    | { iterator: Type }
    | { tuple: List<Type> }
    | { record: List<Field> }
    | { union: List<Type> }
    | { named: Reference }
    | { function: List<Type>, returns: Type, takes: List<Reference> }
    | { brands: List<Brand>, under: Type | null };

/// A field of a record that an expression makes: its name, and the
/// expression of what it holds.
pub type Entry = { name: string, value: Expr };

/// An expression, as data: what a function gives for a comptime call
/// of it to be spliced as code. It names nothing where it is spliced.
///
/// - `definition` is a function or a tag, by reference.
/// - `function` is a function written in place, by the types of its
///   parameters; `local` is a parameter of a function the expression
///   is inside, counted from the outermost one's first.
pub type Expr =
    { literal: null | bool | int | float | string | bytes | Tag }
    | { definition: Reference }
    | { local: int }
    | { call: Expr, given: List<Expr> }
    | { items: List<Expr> }
    | { fields: List<Entry> }
    | { field: string, of: Expr }
    | { function: List<Type>, body: Expr };
