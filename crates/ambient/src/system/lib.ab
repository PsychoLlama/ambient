pub mod clock;
pub mod code;
pub mod console;
pub mod crypto;
pub mod exchange;
pub mod env;
pub mod fs;
pub mod http;
pub mod net;
pub mod path;
pub mod process;
pub mod random;
pub mod stream;

use ambient.errors;
use pkg.clock;
use pkg.code;
use pkg.console;
use pkg.env;
use pkg.fs;
use pkg.http;
use pkg.net;
use pkg.process;
use pkg.random;
use pkg.stream;

extern handler console_write for console.write;
extern handler console_print for console.print;
extern handler console_warn for console.warn;
extern handler(suspending) console_read_line for console.read_line;
extern handler(suspending) console_read for console.read;
extern handler env_args for env.args;
extern handler env_variable for env.variable;
extern handler env_variables for env.variables;
extern handler env_directory for env.directory;
extern handler fs_read for fs.read;
extern handler fs_write for fs.write;
extern handler fs_list for fs.list;
extern handler fs_exists for fs.exists;
extern handler fs_remove for fs.remove;
extern handler fs_make_directory for fs.make_directory;
extern handler fs_info for fs.info;
extern handler fs_append for fs.append;
extern handler fs_rename for fs.rename;
extern handler fs_copy for fs.copy;
extern handler fs_read_bytes for fs.read_bytes;
extern handler fs_write_bytes for fs.write_bytes;
extern handler fs_append_bytes for fs.append_bytes;
extern handler fs_watch for fs.watch;
extern handler(suspending) fs_change for fs.change;
extern handler fs_unwatch for fs.unwatch;
extern handler clock_now for clock.now;
extern handler clock_elapsed for clock.elapsed;
extern handler(suspending) clock_sleep for clock.sleep;
extern handler process_exit for process.exit;
extern handler(suspending) process_run for process.run;
extern handler(suspending) process_signal for process.signal;
extern handler random_bits for random.bits;
extern handler(suspending) http_send for http.send;
extern handler http_listen for http.listen;
extern handler(suspending) http_accept for http.accept;
extern handler http_respond for http.respond;
extern handler http_close for http.close;
extern handler(suspending) stream_read for stream.read;
extern handler(suspending) stream_write for stream.write;
extern handler stream_close for stream.close;
extern handler(suspending) net_connect for net.connect;
extern handler(suspending) net_connect_unix for net.connect_unix;
extern handler net_listen for net.listen;
extern handler net_listen_unix for net.listen_unix;
extern handler(suspending) net_accept for net.accept;
extern handler net_bind for net.bind;
extern handler(suspending) net_join for net.join;
extern handler(suspending) net_send_to for net.send_to;
extern handler(suspending) net_receive for net.receive;
extern handler net_close for net.close;
extern handler code_pack for code.pack;
extern handler code_compile for code.compile;
extern handler code_load for code.load;
extern handler thrown for errors.throw;

/// The world of a program run from a command line.
pub target cli {
    console.write: console_write,
    console.print: console_print,
    console.warn: console_warn,
    console.read_line: console_read_line,
    console.read: console_read,
    env.args: env_args,
    env.variable: env_variable,
    env.variables: env_variables,
    env.directory: env_directory,
    fs.read: fs_read,
    fs.write: fs_write,
    fs.list: fs_list,
    fs.exists: fs_exists,
    fs.remove: fs_remove,
    fs.make_directory: fs_make_directory,
    fs.info: fs_info,
    fs.append: fs_append,
    fs.rename: fs_rename,
    fs.copy: fs_copy,
    fs.read_bytes: fs_read_bytes,
    fs.write_bytes: fs_write_bytes,
    fs.append_bytes: fs_append_bytes,
    fs.watch: fs_watch,
    fs.change: fs_change,
    fs.unwatch: fs_unwatch,
    clock.now: clock_now,
    clock.elapsed: clock_elapsed,
    clock.sleep: clock_sleep,
    process.exit: process_exit,
    process.run: process_run,
    process.signal: process_signal,
    random.bits: random_bits,
    http.send: http_send,
    http.listen: http_listen,
    http.accept: http_accept,
    http.respond: http_respond,
    http.close: http_close,
    stream.read: stream_read,
    stream.write: stream_write,
    stream.close: stream_close,
    net.connect: net_connect,
    net.connect_unix: net_connect_unix,
    net.listen: net_listen,
    net.listen_unix: net_listen_unix,
    net.accept: net_accept,
    net.bind: net_bind,
    net.join: net_join,
    net.send_to: net_send_to,
    net.receive: net_receive,
    net.close: net_close,
    code.pack: code_pack,
    code.compile: code_compile,
    code.load: code_load,
    errors.throw: thrown,
}
