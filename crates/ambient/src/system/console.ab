use pkg.os;

/// Writes text to standard output, as it is.
pub ability write(text: string): null;

/// Writes a line to standard output.
pub ability print(text: string): null;

/// Writes a line to standard error.
pub ability warn(text: string): null;

/// The next line of standard input without its ending, or null at its
/// end. Input that is not text ends the program: it is never altered
/// to make it text.
pub ability read_line(): string | null;

/// What standard input has next, as bytes: at least one and at most
/// `most`, or null at its end. It reads input that is not text, and
/// whatever a line read before it left.
pub ability read(most: int): bytes | null;

// The native side, which answers each under `os` unless a target says otherwise.
extern handler write in os;
extern handler print in os;
extern handler warn in os;
extern handler(suspending) read_line in os;
extern handler(suspending) read in os;
