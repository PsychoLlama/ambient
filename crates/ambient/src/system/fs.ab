use ambient.Error;

/// Nothing is at the path.
pub tag not_found;

/// The program may not do this to what is at the path.
pub tag denied;

/// What the file holds is not text.
pub tag invalid;

/// Any other failure; the message says which.
pub tag failed;

/// A file.
pub tag file;

/// A directory.
pub tag directory;

/// Anything else a path can lead to, such as a device or a socket.
pub tag other;

/// What is at a path: its kind, its size in bytes, and when it last
/// changed, in milliseconds since the start of 1970.
pub type Info = { kind: file | directory | other, size: int, modified: int };

/// The text of a file, which is `invalid` if it does not hold text.
pub ability read(path: string): string | Error;

/// What a file holds, text or not.
pub ability read_bytes(path: string): bytes | Error;

/// Makes a file hold `text`, replacing what it held.
pub ability write(path: string, text: string): null | Error;

/// Makes a file hold `content`, replacing what it held.
pub ability write_bytes(path: string, content: bytes): null | Error;

/// Makes a file hold `content`, replacing what it held, that only its
/// owner may read or write: a key, a token. The file is never open to
/// others with the content in it, whatever the process would otherwise
/// leave a new file as.
pub ability write_private(path: string, content: bytes): null | Error;

/// The names of what a directory holds, in order.
pub ability list(path: string): List<string> | Error;

/// Takes away a file, or a directory and all it holds.
pub ability remove(path: string): null | Error;

/// Makes a directory, and those it is inside that are missing. One
/// that is already there is left as it is.
pub ability make_directory(path: string): null | Error;

/// Whether anything is at the path.
pub ability exists(path: string): bool;

/// What is at a path.
pub ability info(path: string): Info | Error;

/// Adds `text` to the end of a file, which is made if it is not there.
pub ability append(path: string, text: string): null | Error;

/// Adds `content` to the end of a file, which is made if it is not there.
pub ability append_bytes(path: string, content: bytes): null | Error;

/// Moves what is at one path to another, replacing a file there.
pub ability rename(from: string, to: string): null | Error;

/// Makes a file at one path hold what the file at another holds.
pub ability copy(from: string, to: string): null | Error;

/// Something is there that was not.
pub tag created;

/// What something holds, or what is said of it, is different.
pub tag modified;

/// Something that was there is not.
pub tag removed;

/// Changes were not kept, since more came than were taken: whatever
/// is watched may be different, and is to be looked at again.
pub tag missed;

/// What watches a path. It stops when it is closed, or when nothing
/// holds it any more.
pub type(nominal) Watcher;

/// How something changed, and its path. One that was moved is removed
/// at one path and created at another.
pub type Change = { path: string, kind: created | modified | removed | missed };

/// Starts watching a file, or a directory and all it holds.
pub ability watch(path: string): Watcher | Error;

/// The next change a watcher saw, waited for, or null once the
/// watcher is closed.
pub ability change(watcher: Watcher): Change | null;

/// Stops a watcher. Whatever waits on it is given null.
pub ability unwatch(watcher: Watcher): null;
