use pkg.os;

/// What the program was started with, after its own name.
pub ability args(): List<string>;

/// The value of an environment variable, or null if it is not set.
pub ability variable(name: string): string | null;

/// Every environment variable and its value, in order of name.
pub ability variables(): List<(name: string, value: string)>;

/// The directory a path that does not say where it starts is in, or
/// null if the world has none.
pub ability directory(): string | null;

// The native side, which answers each under `os` unless a target says otherwise.
extern handler args in os;
extern handler variable in os;
extern handler variables in os;
extern handler directory in os;
