use ambient.Error;

/// No command of that name is to be found.
pub tag not_found;

/// The program may not run the command.
pub tag denied;

/// Any other failure to start the command; the message says which.
pub tag failed;

/// What a command gave: the code it exited with, which is -1 if it was
/// ended from outside, and what it wrote to each of its streams. A
/// command writes what it likes: `output.out.to_text()` is what it
/// wrote as text, or null if that is not text.
pub type Output = { code: int, out: bytes, err: bytes };

/// Ends the program with an exit code.
pub ability exit(code: int): never;

/// A command to run: a program, found as the system finds one, and
/// what it is started with. No shell reads any of it.
///
/// - `directory` is where it runs, or null for where this program runs.
/// - `variables` are given to it beside this program's, by name and
///   value.
/// - `input` is what it reads from its standard input.
pub type Command = {
    program: string,
    args: List<string>,
    directory: string | null,
    variables: List<(name: string, value: string)>,
    input: bytes,
};

/// Runs a command, and waits until it is over. One that exits with a
/// code that is not zero has still run: only a command that could not
/// be started is an error.
pub ability run(command: Command): Output | Error;

/// A program and its arguments as a command that runs here, is told
/// nothing more, and reads nothing. Copy it to say otherwise:
/// `{ ...process.command("git", ["status"]), directory: "/repo" }`.
pub fn command(program: string, args: List<string>): Command =>
    { program, args, directory: null, variables: [], input: "".to_bytes() };
