use system.console;
use system.env;

/// Greets whoever the program was started with, or the world.
pub fn main(): null with console.print, env.args {
    let names = env.args!();
    if names.length() == 0 {
        console.print!("hello, world");
        return;
    }
    for name in names {
        console.print!("hello, ${name}");
    }
}
