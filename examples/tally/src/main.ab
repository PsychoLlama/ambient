use system.console;
use ambient.map.{self, Map};
use system.env;
use system.fs;
use ambient.test;
use ambient.test.{check, unmet};
use ambient.Error;

/// Prints the words a file uses most, and how often it uses each.
pub fn main(): int with console.print, console.warn, env.args, fs.read {
    match env.args!().first() {
        null => {
            console.warn!("usage: tally <file>");
            return 2;
        }
        let path => { return report(path); }
    }
}

fn report(path: string): int with console.print, console.warn, fs.read {
    match fs.read!(path) {
        let error: Error => {
            console.warn!("${path}: ${error.message}");
            return 1;
        }
        let text: string => {
            most(count(text), 10).each(fn(entry) => console.print!(line(entry)));
            return 0;
        }
    }
}

/// A word, and how often it is in a text.
type Tally = map.Entry<string, int>;

/// How often each word of `text` is in it.
fn count(text: string): Map<Tally> =>
    words(text).fold(map.empty::<Tally>(), fn(seen: Map<Tally>, word: string): Map<Tally> =>
        seen.update(word, fn(times) => (word, (times ?? 0) + 1)));

/// The words of `text`: what its spaces and line endings separate.
fn words(text: string): List<string> =>
    text.lines().fold([], fn(found: List<string>, line: string): List<string> =>
        found + line.split(" ").filter(fn(word) => !word.is_empty()));

/// The `limit` entries counted most, the most first. Entries counted
/// alike stay in the order of their words.
fn most(counts: Map<Tally>, limit: int): List<(word: string, times: int)> =>
    counts.entries()
        .sort_by(fn((_, a), (_, b)) => a > b)
        .iter().take(limit).to_list();

fn line(entry: (word: string, times: int)): string {
    let (word, times) = entry;
    return "${times} ${word}";
}

#[test.case]
fn counts_each_word(): null with unmet {
    let counts = count("a b\na  c");
    check(counts.get("a") == 2, "a word on two lines is counted twice");
    check(counts.size() == 3, "spaces and line endings separate words");
}

#[test.case]
fn the_most_counted_come_first(): null with unmet {
    let top = most(count("b a b c c c"), 2);
    check(top.map(line).join_with(",") == "3 c,2 b", "the two most counted, most first");
}
