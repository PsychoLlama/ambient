/// One thing to do, and whether it is done.
pub type Item = { text: string, done: bool };

/// The line an item is kept as.
pub fn write(item: Item): string => "[${item.done ? "x" : " "}] ${item.text}";

/// The item a line keeps, or null if it keeps none.
pub fn read(line: string): Item | null {
    if line.starts_with("[x] ") {
        return { text: rest(line), done: true };
    }
    if line.starts_with("[ ] ") {
        return { text: rest(line), done: false };
    }
    return null;
}

/// A line after its mark.
fn rest(line: string): string => line.slice(4, line.length()) ?? "";
