/// What the host offers, as JSON: for each name, the types it takes
/// and the type it gives. This is what a tool that reads an interface
/// description would write.
pub fn text(): string =>
    [
        "{",
        "  \"now\": { \"takes\": [], \"gives\": \"int\" },",
        "  \"title\": { \"takes\": [], \"gives\": \"string\" },",
        "  \"alert\": { \"takes\": [\"string\"], \"gives\": \"null\" },",
        "  \"confirm\": { \"takes\": [\"string\"], \"gives\": \"bool\" },",
        "  \"add\": { \"takes\": [\"int\", \"int\"], \"gives\": \"int\" }",
        "}",
    ].join_with("\n");
