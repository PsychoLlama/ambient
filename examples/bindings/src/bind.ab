import ambient.code;
import ambient.errors.{catch, fail, throw};
import ambient.json;
import ambient.json.{Json};
import ambient.map.{Map};
import ambient.tree;
import ambient.Error;
import ambient.build;

/// Asks the host for what it offers under a name: the one way out of
/// the program, which says nothing of what is asked or what comes
/// back. Only the generated `hosted` performs it.
pub ability invoke(name: string, arguments: List<unknown>): unknown;

/// The kind of the error a generated handler throws when the host
/// gives what the manifest says it does not.
pub tag mistyped;

pub fn wrong(name: string): never with throw => fail(mistyped, "the host gave `${name}` what the manifest says it does not");

/// The type the manifest names.
fn named(name: Json): tree.Type {
    match name {
        "int" => { return tree.integer; }
        "string" => { return tree.text; }
        "bool" => { return tree.boolean; }
        _ => { return tree.nil; }
    }
}

/// The manifest, a file of the package: for each name the host
/// offers, the types it takes and the type it gives. It is null if
/// the file is not there or is not JSON.
fn read(): Json with build.read {
    match build.read!("manifest.json") {
        let error: Error => { return null; }
        let text: string => { return parsed(text); }
    }
}

fn parsed(text: string): Json {
    match catch(fn() => json.parse(text)) {
        let error: Error => { return null; }
        let all => { return all; }
    }
}

/// The types of what the host takes for an entry of the manifest.
fn takes(entry: Json): List<tree.Type> {
    match json.get(entry, "takes") {
        let types: List<Json> => { return types.map(named); }
        _ => { return []; }
    }
}

/// The type of what the host gives for an entry of the manifest.
fn gives(entry: Json): tree.Type => named(json.get(entry, "gives"));

/// An ability for an entry of the manifest, by its name there: what
/// a program performs to reach that one thing of the host's, so its
/// row says which it reaches.
fn offered(entry: (string, Json)): tree.Definition {
    let (name, described) = entry;
    return code.named_ability(name, takes(described), gives(described));
}

/// The handler for an entry's ability: it asks the host by name, and
/// gives what came back as the type the manifest says, or throws if
/// it is not that.
fn asking(entry: (string, Json)): (tree.Reference, code.Code) {
    let (name, described) = entry;
    let wrong = code.definition(comptime tree.reference(wrong));
    let handler = code.function(takes(described), fn(given: List<code.Code>): code.Code {
        let asked = code.perform(comptime tree.reference(invoke), [code.literal(name), code.list(given)]);
        return code.cast(asked, gives(described), code.call(wrong, [code.literal(name)]));
    });
    return (code.beside(name, "ability"), handler);
}

/// An entry's ability as a function type's row has it.
fn reached(entry: (string, Json)): tree.Ability {
    let (name, described) = entry;
    return { ability: code.beside(name, "ability"), function: takes(described), returns: gives(described) };
}

/// `hosted`: what runs a body with every ability of the manifest bound
/// to the host. It is the one place the untyped `invoke` is turned
/// into what the manifest says.
fn hosting(entries: List<(string, Json)>): tree.Function =>
    code.generic([null], fn(types: List<tree.Type>): tree.Function {
        let result = types.get(0) as tree.Type else tree.none;
        let body: tree.Type = { function: [], returns: result, takes: entries.map(reached) };
        let needs = [comptime tree.reference(invoke), comptime tree.reference(throw)];
        return code.define([body], result, needs, fn(given: List<code.Code>): code.Code =>
            code.providing(
                code.handlers(entries.map(asking)),
                code.call(given.get(0) as code.Code else code.literal(null), []),
            ));
    });

/// An ability for everything the manifest describes, by its name
/// there, and `hosted`: the whole of a module.
///
/// `comptime bind.all();`
pub fn all(): tree.Module with build.read {
    match read() {
        let entries: Map<Json> => {
            let listed = entries.entries();
            return listed.map(offered).push(code.named("hosted", hosting(listed)));
        }
        _ => { return []; }
    }
}
