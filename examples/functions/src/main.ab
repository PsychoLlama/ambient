import ambient.{catch, Error};
import system.code;
import system.console;
import system.env;
import system.fs;
import system.http;
import system.http.{Request, Response};
import pkg.store;

/// What can be published: a way to answer a request. Its row is all it
/// may do, so a function that was sent reads no file, sends nothing,
/// and prints nothing, whoever wrote it.
type Function = fn(Request): Response with throw;

/// Serves functions it is sent: `functions [port]`.
///
/// - `POST /` with a packed function keeps it, and answers with the
///   path it is called at: `/<hash>`.
/// - Any request to `/<hash>` or under it is answered by that function,
///   which is handed the rest of the path as the request's URL.
///
/// A function is loaded for each request and gone when it is answered;
/// what is kept is its pack, in a file. See `publish.main` to send one.
pub fn main(): int with console, env, fs, http, code.load {
    let port = (env.args!().first() as string else "8080").to_int() as int else 8080;
    match http.listen!("127.0.0.1", port) {
        let error: Error => {
            console.warn!("functions: ${error.message}");
            return 1;
        }
        let server: http.Server => {
            console.print!("post a function to http://127.0.0.1:${server.port}/");
            http.serve(server, 16, fn(request: Request): Response with throw =>
                request.url == "/" ? published(request) : called(request));
            return 0;
        }
    }
}

/// What stands for a function when what was sent is not one.
fn unfit(request: Request): Response with throw => http.text(500, "not a function\n");

/// The function a pack holds, or why it holds none.
fn loaded(packed: bytes): Function | Error with code.load {
    match code.load!(packed) {
        let error: Error => { return error; }
        let loaded: unknown => {
            let function = loaded as Function else unfit;
            return function == unfit ? unsuited() : function;
        }
    }
}

fn unsuited(): Error =>
    { kind: code.invalid, message: "not a way to answer a request", cause: null, trace: [] };

/// Keeps the function a request carries, if it is one, and says where
/// it is called.
fn published(request: Request): Response with fs, code.load {
    if request.method != "POST" {
        return http.text(405, "post a packed function here\n");
    }
    match loaded(request.body) {
        let error: Error => { return http.text(400, "${error.message}\n"); }
        let _: Function => {
            match store.keep(request.body) {
                let error: Error => { return http.text(500, "${error.message}\n"); }
                let name: string => { return http.text(201, "/${name}\n"); }
            }
        }
    }
}

/// Answers a request to `/<hash>/<rest>` with what the function kept
/// under the hash makes of it.
fn called(request: Request): Response with fs.read_bytes, code.load {
    let after = request.url.slice(1, request.url.length()) as string else "";
    let name = after.split("/").first() as string else "";
    let rest = after.slice(name.length(), after.length()) as string else "";
    match store.kept(name) {
        null => { return http.text(404, "no function is called that\n"); }
        let packed: bytes => {
            match loaded(packed) {
                let error: Error => { return http.text(500, "${error.message}\n"); }
                let function: Function => {
                    return run(function, { ...request, url: rest.is_empty() ? "/" : rest });
                }
            }
        }
    }
}

/// What a function makes of a request, within what it may spend. One
/// that throws, faults, or runs on is answered for.
fn run(function: Function, request: Request): Response {
    let outcome = try {
        return budget(steps: 1000000, allocation: 16000000) {
            return catch(fn() => function(request));
        };
    };
    match outcome {
        let response: Response => { return response; }
        let error: Error => { return http.text(500, "the function failed: ${error.message}\n"); }
        _ => { return http.text(503, "the function took too long\n"); }
    }
}
