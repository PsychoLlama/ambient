use ambient.{catch, Error};
use system.code;
use system.console;
use system.env;
use system.fs;
use system.http.{self, Request, Response};
use pkg.store;

/// What can be published: a way to answer a request. Its row is all it
/// may do, so a function that was sent reads no file, sends nothing,
/// and prints nothing, whoever wrote it.
type Function = fn(Request): Response with throw;

/// Serves functions it is sent: `functions [port]`.
///
/// - `POST /` with a packed function compiles it, keeps it, and answers
///   with the path it is called at: `/<hash>`.
/// - Any request to `/<hash>` or under it is answered by that function,
///   which is handed the rest of the path as the request's URL.
///
/// A function is compiled once, when it is posted, and what it compiled
/// to is kept in a file beside its pack. Each request loads that file
/// and lets it go when it is answered, so nothing is held between
/// requests however many functions there are. See `publish.main` to
/// send one.
pub fn main(): int with console, env, fs, http, code.compile, code.load {
    let port = (env.args!().first() ?? "8080").to_int() ?? 8080;
    match http.listen!("127.0.0.1", port) {
        let error: Error => {
            console.warn!("functions: ${error.message}");
            return 1;
        }
        let server: http.Server => {
            console.print!("post a function to http://127.0.0.1:${server.port}/");
            http.serve(server, 16, fn(request: Request): Response with throw =>
                request.url == "/" ? published(request) : called(request));
            return 0;
        }
    }
}

/// What stands for a function when what was sent is not one.
fn unfit(request: Request): Response with throw => http.text(500, "not a function\n");

/// The function compiled code holds, or why it holds none.
fn loaded(compiled: bytes): Function | Error with code.load {
    match code.load!(compiled) {
        let error: Error => { return error; }
        let loaded: unknown => {
            let function = cast::<Function>(loaded) ?? unfit;
            return function == unfit ? unsuited() : function;
        }
    }
}

fn unsuited(): Error =>
    { kind: code.invalid, message: "not a way to answer a request", cause: null, trace: [] };

/// Compiles the function a request carries and keeps it, if it is one,
/// and says where it is called.
fn published(request: Request): Response with fs, code.compile, code.load {
    if request.method != "POST" {
        return http.text(405, "post a packed function here\n");
    }
    match code.compile!(request.body) {
        let error: Error => { return http.text(400, "${error.message}\n"); }
        let compiled: bytes => {
            match loaded(compiled) {
                let error: Error => { return http.text(400, "${error.message}\n"); }
                let _: Function => {}
            }
            match store.keep(request.body, compiled) {
                let error: Error => { return http.text(500, "${error.message}\n"); }
                let name: string => { return http.text(201, "/${name}\n"); }
            }
        }
    }
}

/// The function kept under a name, or nothing if none is. It is loaded
/// from what it compiled to; if that is gone, or another compiler made
/// it, the pack is compiled again.
fn found(name: string): Function | Error | null with fs, code.compile, code.load {
    match store.compiled(name) {
        null => {}
        let compiled: bytes => {
            match loaded(compiled) {
                let function: Function => { return function; }
                let _: Error => {}
            }
        }
    }
    match store.packed(name) {
        null => { return null; }
        let packed: bytes => {
            match code.compile!(packed) {
                let error: Error => { return error; }
                let compiled: bytes => {
                    store.compile(name, compiled);
                    return loaded(compiled);
                }
            }
        }
    }
}

/// Answers a request to `/<hash>/<rest>` with what the function kept
/// under the hash makes of it.
fn called(request: Request): Response with fs, code.compile, code.load {
    let after = request.url.slice(1, request.url.length()) ?? "";
    let name = after.split("/").first() ?? "";
    let rest = after.slice(name.length(), after.length()) ?? "";
    match found(name) {
        null => { return http.text(404, "no function is called that\n"); }
        let error: Error => { return http.text(500, "${error.message}\n"); }
        let function: Function => {
            return run(function, { ...request, url: rest.is_empty() ? "/" : rest });
        }
    }
}

/// What a function makes of a request. One that throws or faults is
/// answered for; nothing ends one that runs on.
fn run(function: Function, request: Request): Response {
    let outcome = contain(fn() => catch(fn() => function(request)));
    match outcome {
        let response: Response => { return response; }
        let error: Error => { return http.text(500, "the function failed: ${error.message}\n"); }
    }
}
