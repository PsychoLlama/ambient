use system.code;
use system.console;
use system.env;
use system.http;
use pkg.samples;

/// Sends one of `samples` to a server that is running, and prints
/// where it can be called. It is the package's binary `publish`,
/// which `main` holds.
pub fn send(): int with code.pack, console, env.args, http.send {
    let args = env.args!();
    let server = args.get(1) ?? "http://127.0.0.1:8080";
    match packed(args.first() ?? "") {
        let error: Error => { return failed(error.message); }
        let packed: bytes => {
            match http.post("${server}/", packed) {
                let error: Error => { return failed(error.message); }
                let response: http.Response => {
                    let said = (response.body.to_text() ?? "").trim();
                    if !http.ok(response) {
                        return failed(said);
                    }
                    console.print!("${server}${said}");
                    return 0;
                }
            }
        }
    }
}

/// The sample of a name, packed.
fn packed(name: string): bytes | Error with code.pack {
    match name {
        "hello" => { return code.pack!(samples.hello); }
        "echo" => { return code.pack!(samples.echo); }
        "sum" => { return code.pack!(samples.sum); }
        _ => {
            return { kind: code.invalid, message: "no sample is called `${name}`: try hello, echo, or sum", cause: null, trace: [] };
        }
    }
}

fn failed(message: string): int with console.warn {
    console.warn!("publish: ${message}");
    return 1;
}
